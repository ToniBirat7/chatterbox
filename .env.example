# PostgreSQL
DB_USER=chatterbox
DB_PASSWORD=change_me_strong_password
DB_NAME=chatterbox

# JWT — use: openssl rand -hex 64
JWT_SECRET=change_me_64_char_hex_string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# URLs (production)
FRONTEND_URL=https://chat.biratcodes.dev
VITE_API_URL=https://chat.biratcodes.dev
VITE_SOCKET_URL=https://chat.biratcodes.dev

# Host ports (docker-compose.yml). Override if 3002/3003 are already taken on
# the deploy host.
FRONTEND_HOST_PORT=3002
BACKEND_HOST_PORT=3003
